# ==========================================
# STLManager - Configuração de Ambiente
# ==========================================

# Caminho da pasta que contém seus arquivos 3D (STL, 3MF, OBJ) no computador host:
#
# No WINDOWS (use barras normais /):
# STL_LIBRARY_PATH=C:/Users/SeuUsuario/Downloads
# ou
# STL_LIBRARY_PATH=D:/Modelos3D
#
# No LINUX:
# STL_LIBRARY_PATH=/home/seu_usuario/Downloads
#
STL_LIBRARY_PATH=./data/library
